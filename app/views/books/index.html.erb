<div class="index-success">
  <%= flash[:notice]%>
</div>

<div class="index-all">
<h2>Books</h2>

  <table>
    <thead>
      <tr>
        <th>Title</th>
        <th>Body</th>
      </tr>
    </thead>

  <tbody>  
    <% @books.each do |book|%>
      <tr>
      <div class="index-table">
        <td><%= book.title%></td>
        <td><%= book.body%></td>
        <td><%= link_to 'Show', book_path(book.id)%></td>
        <td><%= link_to 'Edit', edit_book_path(book.id)%></td>
        <td><%= link_to 'Destroy', book_path(book.id), method: :delete, "data-confirm"=>"Are you sure ?"%></td>
      </div>
      </tr>
    <%end%>
  </tbody>

  </table>



<h2>New book</h2>

<% if @book.errors.any?%>
  <div class="index-error-all">
  <div class="index-error-top">
  <p class="index-error"><%= @book.errors.count%>errors prohibited this book from being saved:</p>
  <ul class="index-error-item">
    <% @book.errors.full_messages.each do |message|%>
      <li><%= message%></li>
    <%end%>
  </ul>
  </div>
  </div>
<%end%>

<%= form_with model: @book, url:'/books', method: :post do |f|%>
  <h4 class="index-title">Title</h4>
  <%= f.text_field :title%>

  <h4 class="index-body">Body</h4>
  <%= f.text_area :body%>

  <div class="index-submit"><%= f.submit '  Create Book  '%></div>

<%end%>

</div>