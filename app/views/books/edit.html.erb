<div class="edit">
<h2>Editing Book</h2>

<%if @book.errors.any?%>
  <div class="edit-error-all">
  <div class="edit-error-top">
  <p class="edit-error"><%= @book.errors.count%>errors prohibited this book from being saved:</p>
  <ul class="edit-error-item">
    <%@book.errors.full_messages.each do |message|%>
      <li><%=message%></li>
    <%end%>
  </ul>
  </div>
  </div>
<%end%>

<%= form_with model:@book, url: book_path(@book.id), method: :patch do |f|%>
  <p class="edit-title">Title</p>
  <%= f.text_field :title %>

  <p class="edit-body">Body</p>
  <%= f.text_area :body%>

  <div class="edit-submit">
  <%= f.submit '  Update Book  '%>
  </div>
  <div class="edit-item">
  <%= link_to 'Show', book_path(@book.id)%>
  <p class="edit-line">|</p>
  <%= link_to 'Back', books_path %>
  </div>
<%end%>
</div>
